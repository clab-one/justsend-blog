{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justsend.blog/schemas/research-pack.schema.json",
  "title": "JustSend Blog Research Source Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic", "generated_at", "sources"],
  "properties": {
    "topic": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "provider", "source_id", "locator", "title", "retrieved_at", "selected", "reason", "artifact_kind", "excerpt", "claim_keys", "sensitivity"],
        "properties": {
          "id": {"type": "string", "pattern": "^RS-[0-9]{3,}$"},
          "kind": {"enum": ["work-record", "repository-source", "official-doc", "web-source", "runtime-observation", "existing-corpus", "user-provided"]},
          "provider": {"enum": ["justsend", "repository", "official-docs", "web", "runtime", "corpus", "user"]},
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "selected": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 10},
          "artifact_kind": {"enum": ["record", "code", "config", "log", "test", "document", "api-contract", "standard", "runtime", "corpus"]},
          "excerpt": {"type": ["string", "null"], "minLength": 20},
          "claim_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "content_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "sensitivity": {"enum": ["public-safe", "redacted", "internal-review"]}
        }
      }
    }
  }
}
